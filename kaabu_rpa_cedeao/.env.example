# ==============================================================================
# .env.example — Modèle de configuration KAABU RPA
#
# 1. Copier ce fichier en ".env" à la racine du projet :  cp .env.example .env
# 2. Remplir CHAQUE valeur ci-dessous avec les vraies informations (jamais commitées).
# 3. Le ".env" réel est exclu de git via .gitignore — ne JAMAIS le retirer du .gitignore
#    ni forcer son ajout avec "git add -f".
# 4. Rien d'autre à faire : le premier keyword de chaque Suite Setup ("Charger Env Dotenv",
#    voir resources/keywords.robot) lit ce .env et exporte ses variables dans l'environnement
#    du process Robot Framework en cours — "robot tests\..." suffit, comme avant.
# ==============================================================================

# --- Identifiants du portail KAABU (compte robot dédié, ex: S_DGSIKAABU_xxx) ---
KAABU_USERNAME=
KAABU_PASSWORD=

# --- Gemini Vision API (OCR ECOWAS / non-Sénégal) ---
# Plusieurs clés supportées pour la répartition de charge / le repli en cas de quota dépassé
# (voir gemini_extractor.py). Au minimum GEMINI_API_KEY_1 est requise.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Optionnel : override du modèle par défaut défini dans gemini_extractor.py
# (actuellement gemini-3.5-flash-lite). Ne définir que pour tester un autre modèle.
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- API OCR interne Orange-Sonatel (CNI sénégalaise, OAuth client credentials) ---
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
# Optionnel : ne définir que pour pointer ailleurs qu'en préprod (voir ocr_cni_orange.py)
# ORANGE_OCR_TOKEN_URL=https://api.preprod.orange-sonatel.com/oauth/token

# --- Compte Outlook Web (OWA) utilisé pour l'envoi du rapport quotidien automatisé ---
# Format attendu pour un compte pro Microsoft 365 : DOMAINE/identifiant (ex: ORANGE-SONATEL/xxx)
OUTLOOK_EMAIL=
OUTLOOK_PASSWORD=

# --- Business rule (optionnel) : override de la liste des pays dont la CNI est acceptée ---
# Codes ISO 3166 alpha-3 séparés par des virgules. Priorité : config/pays_cni_acceptee.txt
# > cette variable > valeur par défaut codée dans schemas.py. Laisser vide pour utiliser le
# défaut du code.
# PAYS_CNI_ACCEPTEE=SEN,BFA,MLI,NER,CIV,TGO,BEN,GNB
